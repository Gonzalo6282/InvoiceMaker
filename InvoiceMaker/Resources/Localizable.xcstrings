    },
    "Sign in with Apple so your subscription follows you to a new iPhone or iPad. Optional: your invoices stay on your device and iCloud either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit Apple an, damit Ihr Abo auf ein neues iPhone oder iPad mitkommt. Optional: Ihre Rechnungen bleiben so oder so auf Ihrem Gerät und in iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Apple para que tu suscripción te acompañe a un nuevo iPhone o iPad. Opcional: tus facturas se quedan en tu dispositivo e iCloud de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec Apple pour retrouver votre abonnement sur un nouvel iPhone ou iPad. Facultatif : vos factures restent sur votre appareil et dans iCloud dans tous les cas."
          }
        }
      }
    },
