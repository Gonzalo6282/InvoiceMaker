    "Free: create, edit and preview unlimited invoices, estimates and receipts, back them up and export them. Premium: send, print and save PDFs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos: unbegrenzt Rechnungen, Angebote und Quittungen erstellen, bearbeiten, ansehen, sichern und exportieren. Premium: PDFs senden, drucken und sichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit : créez, modifiez et prévisualisez factures, devis et reçus sans limite, sauvegardez-les et exportez-les. Premium : envoyez, imprimez et enregistrez vos PDF."
          }
        }
      }
    },
