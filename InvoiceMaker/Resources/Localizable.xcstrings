    "3 days before and on the due date of each unpaid invoice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 Tage vorher und am Fälligkeitstag jeder offenen Rechnung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 días antes y el día de vencimiento de cada factura por cobrar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 jours avant et le jour de l'échéance de chaque facture impayée"
          }
        }
      }
    },
    "A general payment link can't know the invoice total, so your client types the amount." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein allgemeiner Zahlungslink kennt den Rechnungsbetrag nicht, daher gibt Ihr Kunde den Betrag ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace de pago general no conoce el total de la factura, así que tu cliente escribe el monto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien de paiement général ne connaît pas le montant de la facture : votre client saisit le montant."
          }
        }
      }
    },
    "A small line at the bottom of the page. Thanks for helping others find Duly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kleine Zeile unten auf der Seite. Danke, dass Sie anderen helfen, Duly zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea pequeña al pie de la página. Gracias por ayudar a otros a descubrir Duly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite ligne en bas de page. Merci d'aider d'autres personnes à découvrir Duly."
          }
        }
      }
    },
