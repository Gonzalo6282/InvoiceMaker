    },
    "This can't be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible."
          }
        }
      }
    },
    "This deletes your sign-in and unlinks your subscription from it. Your invoices stay on this device and in your iCloud; delete the app to remove them. To stop paying, cancel the subscription in Settings > [your name] > Subscriptions." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime votre connexion et en détache votre abonnement. Vos factures restent sur cet appareil et dans votre iCloud ; supprimez l'app pour les effacer. Pour ne plus payer, résiliez l'abonnement dans Réglages > [votre nom] > Abonnements."
          }
        }
      }
