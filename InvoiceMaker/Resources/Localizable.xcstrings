    },
    "3 days before and on the due date of each unpaid invoice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 Tage vorher und am Fälligkeitstag jeder offenen Rechnung"
