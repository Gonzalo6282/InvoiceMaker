    "Add services and products once, with their price and tax. Then add them to any invoice in one tap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie Leistungen und Produkte einmal mit Preis und Steuer an. Dann fügen Sie sie mit einem Tipp jeder Rechnung hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus servicios y productos una vez, con su precio e impuesto. Luego agrégalos a cualquier factura con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
