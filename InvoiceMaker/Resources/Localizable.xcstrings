    },
    "Your data" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Daten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données"
          }
        }
      }
    },
    "Your invoices are saved on this device and in your own iCloud, which only you can read. A new iPhone or iPad signed in to the same Apple ID gets everything back. If your subscription ends you can still open and export every invoice. Only you can delete your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Rechnungen sind auf diesem Gerät und in Ihrer eigenen iCloud gespeichert, die nur Sie lesen können. Ein neues iPhone oder iPad mit derselben Apple-ID bekommt alles zurück. Wenn Ihr Abo endet, können Sie weiterhin jede Rechnung öffnen und exportieren. Nur Sie können Ihre Daten löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus facturas se guardan en este dispositivo y en tu propio iCloud, que solo tú puedes leer. Un nuevo iPhone o iPad con el mismo ID de Apple recupera todo. Si tu suscripción termina, aún puedes abrir y exportar todas tus facturas. Solo tú puedes eliminar tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos factures sont enregistrées sur cet appareil et dans votre propre iCloud, que vous seul pouvez lire. Un nouvel iPhone ou iPad connecté au même identifiant Apple récupère tout. Si votre abonnement se termine, vous pouvez toujours ouvrir et exporter chaque facture. Vous seul pouvez supprimer vos données."
          }
        }
      }
    },
    "Your monthly invoice is ready" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre monatliche Rechnung ist bereit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu factura mensual está lista"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre facture mensuelle est prête"
          }
        }
      }
    },
    "Your own rates are removed from the list. Invoices already sent keep their rates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre eigenen Sätze werden aus der Liste entfernt. Bereits gesendete Rechnungen behalten ihre Sätze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tasas propias se quitan de la lista. Las facturas ya enviadas conservan sus tasas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos propres taux sont retirés de la liste. Les factures déjà envoyées gardent leurs taux."
          }
        }
      }
    },
    "Your purchase is waiting for approval. Premium unlocks as soon as it's approved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Kauf wartet auf Freigabe. Premium wird freigeschaltet, sobald er genehmigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está esperando aprobación. Premium se desbloquea en cuanto se apruebe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre achat attend une approbation. Premium sera débloqué dès qu'il sera approuvé."
          }
        }
      }
    },
    "Your signature" : {
