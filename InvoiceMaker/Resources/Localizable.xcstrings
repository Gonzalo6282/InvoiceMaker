    "**Accepted.** Signed by %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Angenommen.** Unterschrieben von %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Aceptada.** Firmada por %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Accepté.** Signé par %@."
          }
        }
      }
    },
    "**Backed up to iCloud.** Your documents, clients, logo and settings sync to your own iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**In iCloud gesichert.** Ihre Dokumente, Kunden, Ihr Logo und Ihre Einstellungen werden mit Ihrer eigenen iCloud synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Respaldado en iCloud.** Tus documentos, clientes, logo y ajustes se sincronizan con tu propio iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sauvegardé dans iCloud.** Vos documents, clients, logo et réglages sont synchronisés avec votre propre iCloud."
          }
        }
      }
    },
    "**Free:** create, edit and preview as many invoices as you like. **Premium:** send, print and save PDFs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kostenlos:** beliebig viele Rechnungen erstellen, bearbeiten und ansehen. **Premium:** PDFs senden, drucken und sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Gratis:** crea, edita y revisa todas las facturas que quieras. **Premium:** envía, imprime y guarda PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Gratuit :** créez, modifiez et prévisualisez autant de factures que vous voulez. **Premium :** envoyez, imprimez et enregistrez vos PDF."
          }
        }
      }
    },
    "**Paid on %@.** Send a receipt so your client has proof." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bezahlt am %@.** Senden Sie eine Quittung als Nachweis für Ihren Kunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pagada el %@.** Envía un recibo para que tu cliente tenga un comprobante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Payée le %@.** Envoyez un reçu à votre client comme preuve."
          }
        }
      }
    },
    "**Sent on %@.** Changes save automatically. Send again so %@ has the latest version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Gesendet am %1$@.** Änderungen werden automatisch gesichert. Senden Sie erneut, damit %2$@ die neueste Version hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Enviada el %1$@.** Los cambios se guardan solos. Vuelve a enviarla para que %2$@ tenga la versión más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Envoyée le %1$@.** Les modifications sont enregistrées automatiquement. Renvoyez-la pour que %2$@ ait la dernière version."
          }
        }
      }
    },
    "**Signed by %@.** The signature is on the PDF." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Unterschrieben von %@.** Die Unterschrift steht auf dem PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Firmada por %@.** La firma aparece en el PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Signé par %@.** La signature figure sur le PDF."
          }
        }
      }
    },
    "**iCloud is off.** Open the Settings app, tap your name, then iCloud, and sign in. Until then your invoices are only on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**iCloud ist aus.** Öffnen Sie die Einstellungen-App, tippen Sie auf Ihren Namen, dann auf iCloud, und melden Sie sich an. Bis dahin sind Ihre Rechnungen nur auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**iCloud está desactivado.** Abre la app Configuración, toca tu nombre, luego iCloud, e inicia sesión. Mientras tanto, tus facturas solo están en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**iCloud est désactivé.** Ouvrez Réglages, touchez votre nom, puis iCloud, et connectez-vous. D'ici là, vos factures ne sont que sur cet appareil."
          }
        }
      }
    },
    "1 document" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
