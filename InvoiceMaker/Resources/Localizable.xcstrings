    },
    "Your own rates are removed from the list. Invoices already sent keep their rates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre eigenen Sätze werden aus der Liste entfernt. Bereits gesendete Rechnungen behalten ihre Sätze."
