        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 jours avant et le jour de l'échéance de chaque facture impayée"
          }
        }
      }
    },
    "A general payment link can't know the invoice total, so your client types the amount." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein allgemeiner Zahlungslink kennt den Rechnungsbetrag nicht, daher gibt Ihr Kunde den Betrag ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien de paiement général ne connaît pas le montant de la facture : votre client saisit le montant."
          }
        }
      }
    },
