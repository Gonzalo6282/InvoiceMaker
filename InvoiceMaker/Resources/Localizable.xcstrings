          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld factures · %2$@ impayés"
          }
        }
      }
    },
    "%lld invoices · all paid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Rechnungen · alle bezahlt"
          }
        },
